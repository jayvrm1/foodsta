# ===============================================
# FOODSTA 2.0 Backend Configuration
# ===============================================

# App Environment
PROJECT_NAME="FOODSTA 2.0 API"
VERSION="2.0.0"
DEBUG=True
API_V1_STR="/api"

# Database Configuration
# PostgreSQL (Production): postgresql+psycopg2://postgres:password@localhost:5432/foodsta
# SQLite (Local Dev fallback): sqlite:///./foodsta.db
DATABASE_URL="sqlite:///./foodsta.db"

# JWT Security
SECRET_KEY="foodsta-super-secret-jwt-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Media Upload Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# ===============================================
# Foodoscope APIs (RecipeDB & FlavorDB)
# PLACEHOLDERS - To be populated when credentials arrive
# ===============================================
RECIPEDB_API_BASE_URL="https://api.foodoscope.com/recipedb/v1"
RECIPEDB_API_KEY=""

FLAVORDB_API_BASE_URL="https://api.foodoscope.com/flavordb/v1"
FLAVORDB_API_KEY=""

